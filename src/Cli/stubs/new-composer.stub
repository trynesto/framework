{
    "name": "{{ vendor }}/{{ kebab }}",
    "description": "{{ name }} - a Nesto application",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "nesto/framework": "{{ frameworkConstraint }}"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "php -S 127.0.0.1:3000 -t public public/index.php"
        ],
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
